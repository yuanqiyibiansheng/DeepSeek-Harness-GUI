{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main desktop window",
  "windows": ["main"],
  "remote": {
    "urls": ["http://127.0.0.1:*"]
  },
  "permissions": [
    "core:default",
    "allow-pet-control",
    "allow-restart-service",
    "allow-balance-query",
    "allow-notify-task-done",
    "allow-open-recharge"
  ]
}
